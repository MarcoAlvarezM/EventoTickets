# Variables de entorno de ejemplo. ASP.NET Core las lee automáticamente y tienen prioridad
# sobre appsettings.json (el doble guion bajo "__" equivale a ":" en la configuración).
# Copie este archivo a ".env" o expórtelas en su terminal / perfil de lanzamiento. NO suba valores reales.

# ---------- API (EventoTickets.API) ----------
# Windows con autenticación integrada:
ConnectionStrings__EventCR_BoleteriaPro_DB=Server=localhost;Database=EventCR_BoleteriaPro_DB;Trusted_Connection=True;TrustServerCertificate=True;
# macOS / Linux con SQL Server en Docker:
# ConnectionStrings__EventCR_BoleteriaPro_DB=Server=localhost,1433;Database=EventCR_BoleteriaPro_DB;User Id=sa;Password=CAMBIAR;TrustServerCertificate=True;
# Clave de firma del token (mínimo 32 caracteres). En Development ya existe una en appsettings.Development.json.
Jwt__Clave=CAMBIAR-por-una-clave-larga-y-aleatoria-de-32+caracteres
Ventas__PorcentajeCargoServicio=10
Ventas__PorcentajeIVA=13
Ventas__MinutosReserva=30
# Cada cuántos segundos el API vence reservas expiradas (HU-14). 0 = desactivado.
Ventas__SegundosRevisionExpiracion=60
# Carpeta de comprobantes (fuera de wwwroot). Puede ser absoluta.
Almacenamiento__RutaComprobantes=Almacenamiento/Comprobantes

# ---------- Web (EventoTickets.Web) ----------
Api__UrlBase=http://localhost:5238/

# ---------- Pruebas de integración (API/EventoTickets.Pruebas) ----------
# Cadena a una base de PRUEBAS con los datos iniciales. Sin esta variable las pruebas de concurrencia se omiten.
# EVENTCR_PRUEBAS_SQL=Server=localhost,1433;Database=EventCR_BoleteriaPro_DB;User Id=sa;Password=CAMBIAR;TrustServerCertificate=True;
