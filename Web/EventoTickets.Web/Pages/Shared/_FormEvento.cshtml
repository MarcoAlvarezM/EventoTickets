@model EventoRequest
@* Vista parcial: formulario de evento (Stitch "Crear y editar evento"). Usa ViewData["Categorias"] y ViewData["Locaciones"]. *@
<section class="tarjeta p-6 space-y-5">
    <div class="flex items-center justify-between"><h2 class="font-title-sm text-title-sm">Información general</h2><span class="font-code-sm text-code-sm text-on-surface-variant">PASO 1/3</span></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="flex flex-col gap-1.5 md:col-span-2">
            <label asp-for="Nombre" class="campo-label">Nombre oficial del evento *</label>
            <input asp-for="Nombre" class="campo-input" placeholder="Ej. Cumbre Latinoamericana de Tecnología e IA" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="CodigoReferencia" class="campo-label">Código de referencia</label>
            <input asp-for="CodigoReferencia" class="campo-input font-code-sm uppercase" placeholder="Automático: EVT-AAAA-00000" />
            <span class="campo-ayuda">Déjelo vacío para que el sistema genere un código único (HU-04).</span>
            <span asp-validation-for="CodigoReferencia"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="CategoriaId" class="campo-label">Categoría *</label>
            <select asp-for="CategoriaId" asp-items='(SelectList)ViewData["Categorias"]!' class="campo-input"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="CategoriaId"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="Organizador" class="campo-label">Organizador</label>
            <input asp-for="Organizador" class="campo-input" />
            <span asp-validation-for="Organizador"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="ImagenUrl" class="campo-label">URL de la imagen de portada</label>
            <input asp-for="ImagenUrl" type="url" class="campo-input" placeholder="https://..." />
            <span asp-validation-for="ImagenUrl"></span>
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
            <label asp-for="DescripcionCorta" class="campo-label">Resumen para el catálogo</label>
            <input asp-for="DescripcionCorta" class="campo-input" maxlength="300" />
            <span asp-validation-for="DescripcionCorta"></span>
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
            <label asp-for="DescripcionCompleta" class="campo-label">Descripción completa *</label>
            <textarea asp-for="DescripcionCompleta" rows="6" class="campo-area"></textarea>
            <span asp-validation-for="DescripcionCompleta"></span>
        </div>
    </div>
</section>
<section class="tarjeta p-6 space-y-5">
    <div class="flex items-center justify-between"><h2 class="font-title-sm text-title-sm">Fecha, hora y recinto</h2><span class="font-code-sm text-code-sm text-on-surface-variant">PASO 2/3</span></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="flex flex-col gap-1.5">
            <label asp-for="FechaEvento" class="campo-label">Fecha *</label>
            <input asp-for="FechaEvento" type="date" class="campo-input" />
            <span asp-validation-for="FechaEvento"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="HoraEvento" class="campo-label">Hora de inicio *</label>
            <input asp-for="HoraEvento" type="time" class="campo-input" />
            <span asp-validation-for="HoraEvento"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="LocacionId" class="campo-label">Locación *</label>
            <select asp-for="LocacionId" asp-items='(SelectList)ViewData["Locaciones"]!' class="campo-input"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="LocacionId"></span>
        </div>
    </div>
    <p class="campo-ayuda">Paso 3/3: después de guardar, configure los tipos de entrada y publique el evento.</p>
</section>
