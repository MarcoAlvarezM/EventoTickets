@* Mensajes flash (TempData) en el estilo de los avisos de Stitch *@
@{
    var exito = TempData["MensajeExito"] as string;
    var error = TempData["MensajeError"] as string;
}
@if (!string.IsNullOrEmpty(exito))
{
    <div class="flex items-start gap-3 rounded-xl bg-surface-container-lowest shadow-sm p-4 border-l-4 border-secondary" role="status">
        <span class="material-symbols-outlined text-secondary" style="font-variation-settings:'FILL' 1;">check_circle</span>
        <p class="font-body-md text-body-md text-on-surface">@exito</p>
    </div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="flex items-start gap-3 rounded-xl bg-error-container p-4" role="alert">
        <span class="material-symbols-outlined text-on-error-container">error</span>
        <p class="font-body-md text-body-md text-on-error-container">@error</p>
    </div>
}
