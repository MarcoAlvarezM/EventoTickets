@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Locaciones.DetalleModel
@{ ViewData["Title"] = Model.Registro.Nombre; var l = Model.Registro; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Locaciones</a> › Detalle</nav>
<section class="tarjeta p-6 space-y-5 max-w-3xl">
    <div class="flex items-center justify-between gap-3"><div class="flex items-center gap-3"><h1 class="font-headline-lg text-headline-lg">@l.Nombre</h1><partial name="_EstadoBadge" model="@(l.Activo ? "Activo" : "Inactivo")" /></div>
        <div class="flex gap-2"><a asp-page="Editar" asp-route-id="@l.LocacionId" class="btn-tonal">Editar</a><a asp-page="Eliminar" asp-route-id="@l.LocacionId" class="btn-suave text-error">Eliminar</a></div></div>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 font-body-md text-body-md">
        <div><dt class="campo-ayuda uppercase">Ciudad</dt><dd>@l.Ciudad</dd></div>
        <div><dt class="campo-ayuda uppercase">Dirección</dt><dd>@l.Direccion</dd></div>
        <div><dt class="campo-ayuda uppercase">Pabellón / puerta</dt><dd>@(l.PabellonPuerta ?? "—")</dd></div>
        <div><dt class="campo-ayuda uppercase">Capacidad máxima</dt><dd class="font-headline-md text-headline-md">@l.CapacidadMaxima.ToString("N0", Formato.Cultura)</dd></div>
        <div><dt class="campo-ayuda uppercase">Eventos asociados</dt><dd>@l.CantidadEventos</dd></div>
    </dl>
    @if (l.CantidadEventos > 0) { <p class="rounded-lg bg-surface-container p-3 font-body-sm text-body-sm text-on-surface-variant">No admite eliminación física porque tiene eventos registrados; solo desactivación.</p> }
</section>
