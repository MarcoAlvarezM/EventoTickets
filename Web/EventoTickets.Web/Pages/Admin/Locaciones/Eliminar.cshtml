@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Locaciones.EliminarModel
@{ ViewData["Title"] = "Eliminar locación"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Locaciones</a> › Eliminar</nav>
<section class="tarjeta p-6 space-y-5 max-w-2xl">
    <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-lg bg-error-container text-on-error-container flex items-center justify-center"><span class="material-symbols-outlined">delete</span></span>
        <h1 class="font-headline-lg text-headline-lg">¿Eliminar esta locación?</h1></div>
    <dl class="grid grid-cols-2 gap-4 font-body-md text-body-md"><div><dt class="campo-ayuda">Recinto</dt><dd class="font-semibold">@Model.Registro.Nombre</dd></div><div><dt class="campo-ayuda">Ciudad</dt><dd>@Model.Registro.Ciudad</dd></div><div><dt class="campo-ayuda">Aforo</dt><dd>@Model.Registro.CapacidadMaxima</dd></div><div><dt class="campo-ayuda">Eventos asociados</dt><dd class="font-semibold">@Model.Registro.CantidadEventos</dd></div></dl>
    <p class="rounded-lg bg-surface-container p-3 font-body-sm text-body-sm text-on-surface-variant">Si la locación tiene eventos asociados no se elimina: se desactiva para conservar el historial.</p>
    <form method="post" class="flex justify-between gap-3">
        <a asp-page="Index" class="btn-suave">Cancelar</a>
        <button type="submit" class="btn-peligro"><span class="material-symbols-outlined text-[18px]">delete</span>Confirmar</button>
    </form>
</section>
