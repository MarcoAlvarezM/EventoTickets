@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Eventos.EliminarModel
@{ ViewData["Title"] = "Eliminar evento"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Eventos</a> › Eliminar</nav>
<section class="tarjeta p-6 space-y-5 max-w-2xl">
    <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-lg bg-error-container text-on-error-container flex items-center justify-center"><span class="material-symbols-outlined">delete</span></span>
        <h1 class="font-headline-lg text-headline-lg">¿Eliminar «@Model.Evento.Nombre»?</h1></div>
    <dl class="grid grid-cols-2 gap-4 font-body-md text-body-md">
        <div><dt class="campo-ayuda">Código</dt><dd class="font-code-sm">@Model.Evento.CodigoReferencia</dd></div>
        <div><dt class="campo-ayuda">Estado</dt><dd><partial name="_EstadoBadge" model="Model.Evento.Estado" /></dd></div>
        <div><dt class="campo-ayuda">Fecha</dt><dd>@Formato.Fecha(Model.Evento.FechaEvento)</dd></div>
        <div><dt class="campo-ayuda">Entradas vendidas</dt><dd>@Model.Evento.EntradasVendidas</dd></div>
    </dl>
    <p class="rounded-lg bg-surface-container p-3 font-body-sm text-body-sm text-on-surface-variant">Solo se pueden eliminar eventos sin pedidos (se borran también sus tipos de entrada). Si ya tiene ventas, utilice <strong>Cancelar evento</strong> en el detalle para conservar el historial.</p>
    <form method="post" class="flex justify-between gap-3">
        <a asp-page="Detalle" asp-route-id="@Model.Id" class="btn-suave">Volver</a>
        <button type="submit" class="btn-peligro"><span class="material-symbols-outlined text-[18px]">delete</span>Eliminar definitivamente</button>
    </form>
</section>
