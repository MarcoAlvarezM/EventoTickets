@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.TiposEntrada.EliminarModel
@{ ViewData["Title"] = "Eliminar localidad"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index" asp-route-eventoId="@Model.Tipo.EventoId">Tipos de entrada</a> › Eliminar</nav>
<section class="tarjeta p-6 space-y-5 max-w-2xl">
    <h1 class="font-headline-lg text-headline-lg">¿Eliminar «@Model.Tipo.Nombre»?</h1>
    <dl class="grid grid-cols-2 gap-4 font-body-md text-body-md">
        <div><dt class="campo-ayuda">Evento</dt><dd>@Model.Tipo.EventoNombre</dd></div>
        <div><dt class="campo-ayuda">Precio</dt><dd>@Formato.Moneda(Model.Tipo.Precio)</dd></div>
        <div><dt class="campo-ayuda">Vendidas</dt><dd>@Model.Tipo.CantidadVendida</dd></div>
        <div><dt class="campo-ayuda">Reservadas</dt><dd>@Model.Tipo.CantidadComprometida</dd></div>
    </dl>
    <p class="rounded-lg bg-surface-container p-3 font-body-sm text-body-sm text-on-surface-variant">Si el tipo ya aparece en pedidos, se desactiva para nuevas compras en lugar de eliminarse.</p>
    <form method="post" asp-route-eventoId="@Model.Tipo.EventoId" class="flex justify-between gap-3">
        <a asp-page="Index" asp-route-eventoId="@Model.Tipo.EventoId" class="btn-suave">Cancelar</a>
        <button type="submit" class="btn-peligro"><span class="material-symbols-outlined text-[18px]">delete</span>Confirmar</button>
    </form>
</section>
