@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Usuarios.DetalleModel
@{ ViewData["Title"] = Model.Usuario.NombreCompleto; var u = Model.Usuario; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Usuarios</a> › Detalle</nav>
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-4">
        <span class="w-14 h-14 rounded-full bg-secondary text-on-secondary flex items-center justify-center font-headline-md text-headline-md">@Formato.Iniciales(u.NombreCompleto)</span>
        <div><h1 class="font-headline-lg text-headline-lg">@u.NombreCompleto</h1>
            <div class="flex items-center gap-2"><partial name="_EstadoBadge" model="u.Estado" /><span class="font-body-sm text-body-sm text-on-surface-variant">@Formato.EtiquetaRol(u.Rol)</span></div></div>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-page="Editar" asp-route-id="@u.UsuarioId" class="btn-tonal"><span class="material-symbols-outlined text-[18px]">edit</span>Editar</a>
        <a asp-page="Password" asp-route-id="@u.UsuarioId" class="btn-tonal"><span class="material-symbols-outlined text-[18px]">key</span>Contraseña</a>
        @if (u.Estado != EstadosUsuario.Inactivo)
        {
            <a asp-page="Eliminar" asp-route-id="@u.UsuarioId" class="btn-suave text-error"><span class="material-symbols-outlined text-[18px]">person_remove</span>Eliminar</a>
        }
    </div>
</div>
<div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <section class="xl:col-span-7 tarjeta p-6">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 font-body-md text-body-md">
            <div><dt class="campo-ayuda uppercase">Correo electrónico</dt><dd>@u.CorreoElectronico</dd></div>
            <div><dt class="campo-ayuda uppercase">Teléfono</dt><dd>@(u.Telefono ?? "—")</dd></div>
            <div><dt class="campo-ayuda uppercase">Documento</dt><dd class="font-code-sm">@Formato.EtiquetaDocumento(u.TipoDocumento) @u.NumeroDocumento</dd></div>
            <div><dt class="campo-ayuda uppercase">Registro</dt><dd>@Formato.FechaHora(u.FechaRegistro)</dd></div>
            <div><dt class="campo-ayuda uppercase">Identificador</dt><dd class="font-code-sm">@u.UsuarioId</dd></div>
        </dl>
    </section>
    <section class="xl:col-span-5 tarjeta p-6 space-y-3">
        <h2 class="font-title-sm text-title-sm">Permisos del rol</h2>
        <partial name="_MatrizPermisos" model="u.Rol" />
    </section>
</div>
