@page
@model EventoTickets.Web.Pages.Admin.Usuarios.IndexModel
@{ ViewData["Title"] = "Usuarios y roles"; }
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-1">
        <span class="etiqueta-seccion">Seguridad · RBAC</span>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Gestión de Usuarios y Roles</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">Administra cuentas del personal y compradores, sus roles y su estado de acceso.</p>
    </div>
    <a asp-page="Crear" class="btn-primario"><span class="material-symbols-outlined text-[18px]">person_add</span>Nuevo usuario</a>
</div>

<form method="get" class="tarjeta p-4 grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
    <div class="md:col-span-2 flex flex-col gap-1.5">
        <label asp-for="Busqueda" class="campo-label">Buscar</label>
        <input asp-for="Busqueda" type="search" class="campo-input" placeholder="Nombre, correo o documento" />
    </div>
    <div class="flex flex-col gap-1.5">
        <label asp-for="Rol" class="campo-label">Rol</label>
        <select asp-for="Rol" class="campo-input">
            <option value="">Todos</option>
            @foreach (var r in Roles.Todos) { <option value="@r">@Formato.EtiquetaRol(r)</option> }
        </select>
    </div>
    <div class="flex flex-col gap-1.5">
        <label asp-for="Estado" class="campo-label">Estado</label>
        <select asp-for="Estado" class="campo-input">
            <option value="">Todos</option>
            @foreach (var e in EstadosUsuario.Todos) { <option value="@e">@e</option> }
        </select>
    </div>
    <div class="flex gap-2">
        <select asp-for="Orden" class="campo-input" aria-label="Ordenar"><option value="nombre">Nombre</option><option value="registro">Más recientes</option></select>
        <button type="submit" class="btn-primario">Filtrar</button>
    </div>
</form>

<section class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead><tr class="tabla-encabezado"><th class="tabla-celda">Usuario</th><th class="tabla-celda">Documento</th><th class="tabla-celda">Rol</th><th class="tabla-celda">Estado</th><th class="tabla-celda">Registro</th><th class="tabla-celda text-right">Acciones</th></tr></thead>
            <tbody class="font-body-sm text-body-sm">
                @if (Model.Usuarios.Count == 0) { <tr><td colspan="6" class="tabla-celda text-center text-on-surface-variant">Sin resultados.</td></tr> }
                @foreach (var u in Model.Usuarios)
                {
                    <tr class="hover:bg-surface-container-low">
                        <td class="tabla-celda">
                            <div class="flex items-center gap-3">
                                <span class="w-9 h-9 rounded-full bg-surface-container text-secondary flex items-center justify-center font-label-sm text-label-sm">@Formato.Iniciales(u.NombreCompleto)</span>
                                <div><div class="font-semibold">@u.NombreCompleto</div><div class="text-on-surface-variant">@u.CorreoElectronico</div></div>
                            </div>
                        </td>
                        <td class="tabla-celda font-code-sm">@Formato.EtiquetaDocumento(u.TipoDocumento) @u.NumeroDocumento</td>
                        <td class="tabla-celda">@Formato.EtiquetaRol(u.Rol)</td>
                        <td class="tabla-celda"><partial name="_EstadoBadge" model="u.Estado" /></td>
                        <td class="tabla-celda text-on-surface-variant">@Formato.Fecha(u.FechaRegistro)</td>
                        <td class="tabla-celda">
                            <div class="flex justify-end gap-1">
                                <a asp-page="Detalle" asp-route-id="@u.UsuarioId" class="btn-suave h-8 px-2" title="Detalle"><span class="material-symbols-outlined text-[18px]">visibility</span></a>
                                <a asp-page="Editar" asp-route-id="@u.UsuarioId" class="btn-suave h-8 px-2" title="Editar"><span class="material-symbols-outlined text-[18px]">edit</span></a>
                                <a asp-page="Password" asp-route-id="@u.UsuarioId" class="btn-suave h-8 px-2" title="Restablecer contraseña"><span class="material-symbols-outlined text-[18px]">key</span></a>
                                @if (u.UsuarioId.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                {
                                    var nuevo = u.Estado == EstadosUsuario.Activo ? EstadosUsuario.Bloqueado : EstadosUsuario.Activo;
                                    <form method="post" asp-page-handler="Estado" asp-route-id="@u.UsuarioId" asp-route-estado="@nuevo"
                                          asp-route-busqueda="@Model.Busqueda" asp-route-rol="@Model.Rol" data-confirmar="¿Cambiar el estado de @u.NombreCompleto a @nuevo?">
                                        <button type="submit" class="btn-suave h-8 px-2 @(nuevo == EstadosUsuario.Bloqueado ? "text-error" : "text-secondary")" title="@(nuevo == EstadosUsuario.Bloqueado ? "Bloquear" : "Reactivar")">
                                            <span class="material-symbols-outlined text-[18px]">@(nuevo == EstadosUsuario.Bloqueado ? "person_off" : "person_check")</span>
                                        </button>
                                    </form>
                                    @if (u.Estado != EstadosUsuario.Inactivo)
                                    {
                                        <a asp-page="Eliminar" asp-route-id="@u.UsuarioId" class="btn-suave h-8 px-2 text-error" title="Eliminar (lógico)"><span class="material-symbols-outlined text-[18px]">person_remove</span></a>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
