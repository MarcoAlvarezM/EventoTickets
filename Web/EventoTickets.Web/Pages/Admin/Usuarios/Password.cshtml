@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Usuarios.PasswordModel
@{ ViewData["Title"] = "Restablecer contraseña"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Usuarios</a> › Restablecer contraseña</nav>
<form method="post" class="tarjeta p-6 space-y-5 max-w-xl" novalidate>
    <h1 class="font-headline-lg text-headline-lg">Restablecer contraseña</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Usuario: <strong>@Model.Usuario.NombreCompleto</strong> (@Model.Usuario.CorreoElectronico)</p>
    <div asp-validation-summary="ModelOnly"></div>
    <div class="flex flex-col gap-1.5">
        <label asp-for="Entrada.PasswordNueva" class="campo-label">Nueva contraseña *</label>
        <input asp-for="Entrada.PasswordNueva" class="campo-input" autocomplete="new-password" />
        <span class="campo-ayuda">Comuníquela al usuario por un canal seguro.</span>
        <span asp-validation-for="Entrada.PasswordNueva"></span>
    </div>
    <div class="flex justify-between gap-3">
        <a asp-page="Index" class="btn-suave">Cancelar</a>
        <button type="submit" class="btn-acento"><span class="material-symbols-outlined text-[18px]">key</span>Guardar contraseña</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
