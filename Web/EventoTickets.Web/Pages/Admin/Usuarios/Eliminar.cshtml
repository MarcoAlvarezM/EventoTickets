@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Usuarios.EliminarModel
@{ ViewData["Title"] = "Eliminar usuario"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Usuarios</a> › Eliminar</nav>
<section class="tarjeta p-6 space-y-5 max-w-2xl">
    <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-lg bg-error-container text-on-error-container flex items-center justify-center"><span class="material-symbols-outlined">person_remove</span></span>
        <h1 class="font-headline-lg text-headline-lg">¿Eliminar la cuenta de @Model.Usuario.NombreCompleto?</h1></div>
    <dl class="grid grid-cols-2 gap-4 font-body-md text-body-md">
        <div><dt class="campo-ayuda">Correo</dt><dd>@Model.Usuario.CorreoElectronico</dd></div>
        <div><dt class="campo-ayuda">Rol</dt><dd>@Formato.EtiquetaRol(Model.Usuario.Rol)</dd></div>
    </dl>
    <p class="rounded-lg bg-surface-container p-3 font-body-sm text-body-sm text-on-surface-variant">Es un <strong>borrado lógico</strong>: la cuenta pasa a <em>Inactivo</em> y ya no puede iniciar sesión, pero sus pedidos, pagos y entradas se conservan para la trazabilidad. Para suspender temporalmente use <strong>Bloquear</strong>.</p>
    <form method="post" class="flex justify-between gap-3">
        <a asp-page="Detalle" asp-route-id="@Model.Id" class="btn-suave">Cancelar</a>
        <button type="submit" class="btn-peligro"><span class="material-symbols-outlined text-[18px]">person_remove</span>Confirmar eliminación</button>
    </form>
</section>
