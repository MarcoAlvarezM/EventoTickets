@page "{id:int}"
@model EventoTickets.Web.Pages.Admin.Usuarios.EditarModel
@{ ViewData["Title"] = "Editar usuario"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="Index">Usuarios</a> › @Model.Usuario.NombreCompleto</nav>
<div class="flex items-center gap-4">
    <span class="w-14 h-14 rounded-full bg-secondary text-on-secondary flex items-center justify-center font-headline-md text-headline-md">@Formato.Iniciales(Model.Usuario.NombreCompleto)</span>
    <div><h1 class="font-headline-lg text-headline-lg">@Model.Usuario.NombreCompleto</h1>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Registrado el @Formato.FechaHora(Model.Usuario.FechaRegistro) · ID @Model.Usuario.UsuarioId</p></div>
</div>
<form method="post" class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start" novalidate>
    <div class="xl:col-span-8 space-y-6">
        <div asp-validation-summary="ModelOnly"></div>
        <section class="tarjeta p-6 space-y-5">
            <h2 class="font-title-sm text-title-sm">Datos personales</h2>
            <partial name="_FormUsuario" for="Entrada" />
        </section>
        <section class="tarjeta p-6 space-y-4">
            <h2 class="font-title-sm text-title-sm">Rol principal (RBAC)</h2>
            <partial name="_SelectorRol" model="Model.Entrada.Rol" />
        </section>
    </div>
    <aside class="xl:col-span-4 space-y-6">
        <section class="tarjeta p-6 space-y-4">
            <h2 class="font-title-sm text-title-sm">Estado de la cuenta</h2>
            <select asp-for="Entrada.Estado" class="campo-input">
                @foreach (var e in EstadosUsuario.Todos) { <option value="@e">@e</option> }
            </select>
            <div class="flex flex-col gap-2 pt-2">
                <button type="submit" class="btn-acento h-11"><span class="material-symbols-outlined text-[18px]">save</span>Guardar cambios</button>
                <a asp-page="Password" asp-route-id="@Model.Id" class="btn-tonal"><span class="material-symbols-outlined text-[18px]">key</span>Restablecer contraseña</a>
                <a asp-page="Index" class="btn-suave">Volver</a>
            </div>
        </section>
        <section class="tarjeta p-6 space-y-3">
            <h2 class="font-title-sm text-title-sm">Permisos del rol actual</h2>
            <partial name="_MatrizPermisos" model="Model.Usuario.Rol" />
        </section>
    </aside>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
