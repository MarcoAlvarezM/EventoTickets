@page
@model EventoTickets.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Panel de control";
    var k = Model.Panel.Indicadores;
    bool gestion = User.IsInRole(Roles.Superadministrador) || User.IsInRole(Roles.AdministradorEventos);
    bool supervision = gestion || User.IsInRole(Roles.AuditorPagos);
}
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-1">
        <div class="flex items-center gap-2"><span class="etiqueta-seccion">Métrica &amp; control en vivo</span><span class="inline-block w-1.5 h-1.5 rounded-full bg-secondary"></span></div>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Panel de Control General</h1>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Monitoreo operativo de eventos, venta de entradas y validación de pagos manuales.</p>
    </div>
    @if (supervision)
    {
        <a asp-page="/Admin/Reportes/Index" class="btn-tonal bg-surface-container-lowest shadow-sm"><span class="material-symbols-outlined text-[18px]">download</span>Exportar reporte</a>
    }
</div>

<div class="tarjeta p-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary"><span class="material-symbols-outlined text-[22px]">flash_on</span></div>
        <div><p class="font-title-sm text-title-sm font-semibold">Acciones operativas</p><p class="font-body-sm text-body-sm text-on-surface-variant">Accesos directos según tu rol</p></div>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        @if (gestion) { <a asp-page="/Admin/Eventos/Crear" class="btn-primario"><span class="material-symbols-outlined text-[18px]">add_circle</span>Crear nuevo evento</a> }
        @if (supervision)
        {
            <a asp-page="/Admin/Pagos/Index" asp-route-estado="@EstadosPago.PendienteValidacion" class="btn-acento"><span class="material-symbols-outlined text-[18px]">verified_user</span>Revisar pagos pendientes
                <span class="px-2 py-0.5 rounded-full bg-surface-container-lowest text-secondary font-code-sm text-code-sm font-semibold">@k.PagosPorValidar</span></a>
        }
        @if (User.IsInRole(Roles.Superadministrador)) { <a asp-page="/Admin/Usuarios/Index" class="btn-tonal"><span class="material-symbols-outlined text-[18px]">person_search</span>Gestionar usuarios</a> }
        @if (User.IsInRole(Roles.Superadministrador) || User.IsInRole(Roles.ValidadorAcceso)) { <a asp-page="/Admin/Accesos/Index" class="btn-tonal"><span class="material-symbols-outlined text-[18px]">qr_code_scanner</span>Validar acceso</a> }
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
    @{
        var kpis = new[]
        {
            ("Eventos publicados", "confirmation_number", k.EventosPublicados.ToString("N0", Formato.Cultura), $"{k.EventosBorrador} en borrador • {k.EventosFinalizados} finalizados"),
            ("Usuarios registrados", "group", k.UsuariosRegistrados.ToString("N0", Formato.Cultura), $"+{k.UsuariosNuevosHoy} nuevos hoy"),
            ("Pedidos totales", "shopping_cart", k.PedidosTotales.ToString("N0", Formato.Cultura), $"{k.PedidosEnProceso} en proceso de cobro"),
            ("Pagos por validar", "pending_actions", k.PagosPorValidar.ToString("N0", Formato.Cultura), "Revisión manual en cola"),
            ("Entradas emitidas", "local_activity", k.EntradasEmitidas.ToString("N0", Formato.Cultura), $"Ingresos: {Formato.Moneda(k.IngresosTotales)}")
        };
    }
    @foreach (var (titulo, icono, valor, nota) in kpis)
    {
        <div class="tarjeta p-5 flex flex-col justify-between relative overflow-hidden">
            @if (icono == "pending_actions" && k.PagosPorValidar > 0) { <div class="absolute top-0 left-0 right-0 h-1 bg-secondary"></div> }
            <div class="flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">@titulo</span>
                <div class="w-8 h-8 rounded-lg bg-surface-container-low flex items-center justify-center text-secondary"><span class="material-symbols-outlined text-[18px]">@icono</span></div>
            </div>
            <div class="mt-4">
                <div class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg font-bold leading-none">@valor</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-2">@nota</p>
            </div>
        </div>
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8 space-y-8">
        <section class="tarjeta overflow-hidden">
            <div class="p-5 flex items-center justify-between bg-surface-container-low">
                <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-secondary @(Model.Panel.PagosPendientes.Count > 0 ? "animate-pulse" : "")"></div>
                    <div><h2 class="font-headline-md text-headline-md">Pagos manuales pendientes de validación</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Comprobantes en espera, del más antiguo al más reciente</p></div>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-surface-container text-secondary font-code-sm text-code-sm font-semibold">@k.PagosPorValidar en espera</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead><tr class="tabla-encabezado"><th class="tabla-celda">ID Pago</th><th class="tabla-celda">Pedido</th><th class="tabla-celda">Comprador</th><th class="tabla-celda text-right">Monto</th><th class="tabla-celda">Ref. bancaria</th><th class="tabla-celda">Fecha</th><th class="tabla-celda text-center">Acción</th></tr></thead>
                    <tbody class="font-body-sm text-body-sm">
                        @if (Model.Panel.PagosPendientes.Count == 0)
                        {
                            <tr><td colspan="7" class="tabla-celda text-center text-on-surface-variant">No hay pagos pendientes. ¡Todo al día!</td></tr>
                        }
                        @foreach (var p in Model.Panel.PagosPendientes)
                        {
                            <tr class="hover:bg-surface-container-low">
                                <td class="tabla-celda font-code-sm text-code-sm font-semibold text-secondary">#@p.CodigoPago</td>
                                <td class="tabla-celda font-code-sm text-code-sm">#@p.CodigoPedido</td>
                                <td class="tabla-celda"><div class="font-semibold">@p.CompradorNombre</div><div class="text-[11px] text-on-surface-variant">@p.CompradorCorreo</div></td>
                                <td class="tabla-celda font-code-sm text-code-sm font-semibold text-right">@Formato.Moneda(p.MontoReportado)</td>
                                <td class="tabla-celda font-code-sm text-code-sm text-on-surface-variant">@p.ReferenciaComprobante</td>
                                <td class="tabla-celda text-on-surface-variant">@Formato.FechaHora(p.FechaReporte)</td>
                                <td class="tabla-celda text-center">
                                    @if (supervision)
                                    {
                                        <a asp-page="/Admin/Pagos/Detalle" asp-route-id="@p.PagoId" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container hover:bg-secondary hover:text-on-secondary text-secondary font-label-sm text-label-sm transition-colors"><span class="material-symbols-outlined text-[16px]">receipt_long</span>Revisar</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="tarjeta overflow-hidden">
            <div class="p-5 flex items-center justify-between">
                <div><h2 class="font-headline-md text-headline-md">Pedidos recientes en el sistema</h2><p class="font-body-sm text-body-sm text-on-surface-variant">Flujo de transacciones y estados de compra</p></div>
                @if (supervision) { <a asp-page="/Admin/Pedidos/Index" class="font-label-md text-label-md text-secondary hover:underline">Ver todos</a> }
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead><tr class="tabla-encabezado"><th class="tabla-celda"># Pedido</th><th class="tabla-celda">Fecha</th><th class="tabla-celda">Comprador</th><th class="tabla-celda">Evento</th><th class="tabla-celda text-center">Entradas</th><th class="tabla-celda text-right">Total</th><th class="tabla-celda">Estado</th></tr></thead>
                    <tbody class="font-body-sm text-body-sm">
                        @foreach (var p in Model.Panel.PedidosRecientes)
                        {
                            <tr class="hover:bg-surface-container-low">
                                <td class="tabla-celda font-code-sm text-code-sm">@if (supervision) { <a asp-page="/Admin/Pedidos/Detalle" asp-route-id="@p.PedidoId" class="text-secondary hover:underline">#@p.CodigoPedido</a> } else { <span>#@p.CodigoPedido</span> }</td>
                                <td class="tabla-celda text-on-surface-variant">@Formato.FechaHora(p.FechaCreacion)</td>
                                <td class="tabla-celda">@p.CompradorNombre</td>
                                <td class="tabla-celda">@p.EventoNombre</td>
                                <td class="tabla-celda text-center font-code-sm">@p.CantidadEntradas</td>
                                <td class="tabla-celda text-right font-code-sm">@Formato.Moneda(p.ImporteTotal)</td>
                                <td class="tabla-celda"><partial name="_EstadoBadge" model="p.Estado" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="lg:col-span-4 space-y-6">
        <section class="tarjeta p-5 space-y-4">
            <div><h2 class="font-headline-md text-headline-md">Próximos eventos</h2><p class="font-body-sm text-body-sm text-on-surface-variant">Capacidad y ventas en tiempo real</p></div>
            @if (Model.Panel.ProximosEventos.Count == 0) { <p class="font-body-sm text-body-sm text-on-surface-variant">No hay eventos publicados próximos.</p> }
            @foreach (var e in Model.Panel.ProximosEventos)
            {
                var pct = (int)(e.PorcentajeOcupacion ?? 0);
                <div class="rounded-lg bg-surface-container-low p-4 space-y-2">
                    <div class="flex justify-between gap-2"><p class="font-title-sm text-title-sm line-clamp-1">@e.EventoNombre</p><span class="font-code-sm text-code-sm text-secondary">@pct%</span></div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">@e.LocacionNombre · @Formato.Fecha(e.FechaEvento)</p>
                    <div class="h-2 rounded-full bg-surface-container-high overflow-hidden"><div class="h-full bg-secondary" style="width:@pct%"></div></div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">@e.EntradasVendidas / @e.CapacidadAsignada vendidas · @e.EntradasDisponibles disponibles</p>
                </div>
            }
        </section>
    </aside>
</div>
