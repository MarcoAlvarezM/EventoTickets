@page "{pedidoId:int}"
@model EventoTickets.Web.Pages.Compras.RegistrarPagoModel
@{ ViewData["Title"] = "Registrar pago manual"; }

<nav class="flex flex-wrap items-center gap-1.5 font-body-sm text-body-sm text-on-surface-variant">
    <a asp-page="/Index" class="hover:text-on-surface">Inicio</a><span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a asp-page="/MisPedidos/Index" class="hover:text-on-surface">Mis Pedidos</a><span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span>Pedido #@Model.Pedido.CodigoPedido</span><span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-secondary font-medium">Registrar Pago</span>
</nav>

<section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-3">
            <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Registrar Pago Manual</h1>
            <partial name="_EstadoBadge" model="@EstadosPedido.PendientePago" view-data='new ViewDataDictionary(ViewData) { ["Etiqueta"] = "Pendiente de reporte" }' />
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant">Realiza la transferencia a la cuenta oficial y reporta los datos junto con el comprobante para emitir tus entradas con código QR.</p>
    </div>
    <div class="tarjeta px-4 py-3 flex items-center gap-3" data-contenedor-reserva>
        <span class="material-symbols-outlined text-secondary">timer</span>
        <div><p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Tiempo de reserva</p>
            <p class="font-code-sm text-code-sm text-secondary font-semibold" data-vence="@Model.Pedido.FechaVencimientoReserva.ToString("yyyy-MM-ddTHH:mm:ss")"></p></div>
    </div>
</section>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <form method="post" enctype="multipart/form-data" class="lg:col-span-8 space-y-6" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Entrada.PedidoId" />

        <section class="tarjeta p-6 space-y-4">
            <h2 class="flex items-center gap-3 font-title-sm text-title-sm"><span class="w-7 h-7 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-[13px]">1</span>Cuenta destino oficial</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 rounded-lg bg-surface-container-low p-4 font-body-md text-body-md">
                <div><p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Cuenta IBAN</p><p class="font-code-sm">@Model.Cuenta.CuentaIban</p></div>
                <div><p class="font-label-sm text-label-sm text-on-surface-variant uppercase">SINPE Móvil</p><p class="font-code-sm">@Model.Cuenta.SinpeMovil</p></div>
                <div><p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Titular</p><p>@Model.Cuenta.Titular</p><p class="font-code-sm text-on-surface-variant">@Model.Cuenta.CedulaJuridica</p></div>
            </div>
            <p class="flex items-start gap-2 font-body-sm text-body-sm text-on-surface-variant"><span class="material-symbols-outlined text-[16px] text-secondary">info</span>Incluye la referencia <strong class="font-code-sm text-secondary">@Model.Pedido.ReferenciaBancariaUnica</strong> en la descripción para acelerar la conciliación.</p>
        </section>

        <section class="tarjeta p-6 space-y-5">
            <h2 class="flex items-center gap-3 font-title-sm text-title-sm"><span class="w-7 h-7 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-[13px]">2</span>Datos de la transacción</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Entrada.BancoOrigen" class="campo-label">Entidad bancaria de origen *</label>
                    <select asp-for="Entrada.BancoOrigen" class="campo-input" asp-items="@(new SelectList(EventoTickets.Web.Pages.Compras.RegistrarPagoModel.Bancos))">
                        <option value="">Seleccione…</option>
                    </select>
                    <span asp-validation-for="Entrada.BancoOrigen"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Entrada.ReferenciaComprobante" class="campo-label">N.º de referencia / comprobante *</label>
                    <input asp-for="Entrada.ReferenciaComprobante" class="campo-input font-code-sm" placeholder="Ej. 884920" />
                    <span class="campo-ayuda">Código que emite tu banco al completar la transferencia.</span>
                    <span asp-validation-for="Entrada.ReferenciaComprobante"></span>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Entrada.MontoReportado" class="campo-label">Monto exacto transferido (CRC) *</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-on-surface-variant font-code-sm">₡</span>
                        <input asp-for="Entrada.MontoReportado" type="number" step="0.01" min="1" class="campo-input pl-8 font-code-sm" />
                    </div>
                    <span class="campo-ayuda">Debe ser igual o mayor al total del pedido (@Formato.MonedaExacta(Model.Pedido.ImporteTotal)).</span>
                    <span asp-validation-for="Entrada.MontoReportado"></span>
                </div>
            </div>
        </section>

        <section class="tarjeta p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="flex items-center gap-3 font-title-sm text-title-sm"><span class="w-7 h-7 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-[13px]">3</span>Comprobante oficial</h2>
                <span class="font-body-sm text-body-sm text-on-surface-variant">JPG, PNG o PDF · máx. 10 MB</span>
            </div>
            <label class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-outline-variant bg-surface-container-low p-8 cursor-pointer hover:bg-surface-container">
                <span class="material-symbols-outlined text-[36px] text-secondary">cloud_upload</span>
                <span class="font-label-md text-label-md">Haz clic para seleccionar el comprobante</span>
                <span id="nombre-archivo" class="font-code-sm text-code-sm text-on-surface-variant">Ningún archivo seleccionado</span>
                <input asp-for="Entrada.Comprobante" type="file" accept=".jpg,.jpeg,.png,.pdf" class="sr-only" data-vista-archivo="nombre-archivo" />
            </label>
            <span asp-validation-for="Entrada.Comprobante"></span>
        </section>

        <section class="tarjeta p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="flex items-center gap-3 font-title-sm text-title-sm"><span class="w-7 h-7 rounded-full bg-surface-container-high flex items-center justify-center text-[13px]">4</span>Observaciones</h2>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Opcional</span>
            </div>
            <textarea asp-for="Entrada.NotaComprador" rows="3" class="campo-area" placeholder="Ej. Realicé la transferencia desde mi cuenta de ahorros a las 2:30 p.m."></textarea>
            <span asp-validation-for="Entrada.NotaComprador"></span>
            <label class="flex items-start gap-2.5 rounded-lg bg-surface-container-low p-4 cursor-pointer">
                <input asp-for="Declaracion" class="mt-0.5 w-4 h-4 accent-secondary" />
                <span class="font-body-sm text-body-sm text-on-surface">Declaro que el comprobante adjunto corresponde a una transacción real y verificable por el monto de este pedido. Los comprobantes duplicados o alterados anulan la orden.</span>
            </label>
            <span asp-validation-for="Declaracion"></span>
        </section>

        <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-3">
            <a asp-page="/Compras/Checkout" asp-route-pedidoId="@Model.PedidoId" class="btn-suave"><span class="material-symbols-outlined text-[18px]">arrow_back</span>Volver al pedido</a>
            <button type="submit" class="btn-acento h-12 px-6"><span class="material-symbols-outlined text-[18px]">send</span>Enviar reporte de pago</button>
        </div>
    </form>

    <aside class="lg:col-span-4 space-y-4">
        <partial name="_ResumenPedido" model="Model.Pedido" />
        <section class="tarjeta p-5 space-y-4">
            <h3 class="font-title-sm text-title-sm flex items-center gap-2"><span class="material-symbols-outlined text-secondary">help</span>¿Qué ocurre tras reportar el pago?</h3>
            <ol class="space-y-3 font-body-sm text-body-sm text-on-surface-variant">
                <li class="flex gap-3"><span class="font-code-sm text-secondary">01</span><span><strong class="text-on-surface">Recepción inmediata.</strong> El comprobante entra a la cola de validación.</span></li>
                <li class="flex gap-3"><span class="font-code-sm text-secondary">02</span><span><strong class="text-on-surface">Auditoría.</strong> Un auditor verifica monto y referencia contra el estado de cuenta.</span></li>
                <li class="flex gap-3"><span class="font-code-sm text-secondary">03</span><span><strong class="text-on-surface">Emisión QR.</strong> Al aprobarse, tus entradas aparecen en "Mis Entradas".</span></li>
            </ol>
        </section>
    </aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
