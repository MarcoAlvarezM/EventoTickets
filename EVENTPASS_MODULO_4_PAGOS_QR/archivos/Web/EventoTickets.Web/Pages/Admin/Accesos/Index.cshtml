@page
@model EventoTickets.Web.Pages.Admin.Accesos.IndexModel
@{ ViewData["Title"] = "Control de acceso"; }
<div class="space-y-1">
    <span class="etiqueta-seccion">Operación en puerta</span>
    <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Control de Acceso</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Escanee el QR (lector tipo teclado) o digite el código de la entrada para registrar el ingreso.</p>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <form method="post" class="lg:col-span-5 tarjeta p-6 space-y-5" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="Entrada.CodigoTicket" class="campo-label">Código de la entrada o contenido del QR *</label>
            <div class="relative flex items-center"><span class="material-symbols-outlined absolute left-3 text-outline text-[20px]">qr_code_scanner</span>
                <input asp-for="Entrada.CodigoTicket" class="campo-input pl-10 h-12 font-code-sm" placeholder="TKT-000001-001-AB12CD" autofocus autocomplete="off" /></div>
            <span asp-validation-for="Entrada.CodigoTicket"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="Entrada.PuertaAcceso" class="campo-label">Puerta / punto de control</label>
            <input asp-for="Entrada.PuertaAcceso" class="campo-input" placeholder="Ej. Puerta 1 Norte" />
            <span class="campo-ayuda">Se conserva entre lecturas.</span>
        </div>
        <button type="submit" class="btn-acento w-full h-12"><span class="material-symbols-outlined text-[20px]">how_to_reg</span>Validar ingreso</button>
    </form>
    <section class="lg:col-span-7">
        @if (Model.Validada is { } e)
        {
            <div class="tarjeta overflow-hidden">
                <div class="bg-emerald-700 text-white p-5 flex items-center gap-3"><span class="material-symbols-outlined text-[36px]">check_circle</span>
                    <div><p class="font-headline-md text-headline-md">Acceso autorizado</p><p class="font-body-sm text-body-sm opacity-90">Ingreso registrado el @Formato.FechaHoraOpcional(e.FechaHoraIngreso)</p></div></div>
                <dl class="p-6 grid grid-cols-2 gap-4 font-body-md text-body-md">
                    <div><dt class="campo-ayuda">Asistente</dt><dd class="font-semibold">@e.NombreAsistente</dd></div>
                    <div><dt class="campo-ayuda">Documento a verificar</dt><dd class="font-code-sm">@e.DocumentoAsistente</dd></div>
                    <div><dt class="campo-ayuda">Evento</dt><dd>@e.EventoNombre</dd></div>
                    <div><dt class="campo-ayuda">Tipo / ubicación</dt><dd>@e.TipoEntradaNombre · @e.AsientoAsignado</dd></div>
                    <div><dt class="campo-ayuda">Puerta</dt><dd>@e.PuertaAcceso</dd></div>
                    <div><dt class="campo-ayuda">Código</dt><dd class="font-code-sm break-all">@e.CodigoTicket</dd></div>
                </dl>
            </div>
        }
        else if (Model.Rechazo is not null)
        {
            <div class="tarjeta overflow-hidden">
                <div class="bg-error text-on-error p-5 flex items-center gap-3"><span class="material-symbols-outlined text-[36px]">cancel</span>
                    <div><p class="font-headline-md text-headline-md">Acceso denegado</p><p class="font-body-sm text-body-sm opacity-90">@Model.Rechazo</p></div></div>
                <p class="p-6 font-body-md text-body-md text-on-surface-variant">No permita el ingreso. Si el asistente insiste, remítalo a la mesa de asistencia con su pedido.</p>
            </div>
        }
        else
        {
            <div class="tarjeta p-10 text-center space-y-3"><span class="material-symbols-outlined text-[48px] text-on-surface-variant">qr_code_2</span>
                <p class="font-title-sm text-title-sm">Esperando lectura…</p><p class="font-body-md text-body-md text-on-surface-variant">El resultado de la validación aparecerá aquí.</p></div>
        }
    </section>
</div>
