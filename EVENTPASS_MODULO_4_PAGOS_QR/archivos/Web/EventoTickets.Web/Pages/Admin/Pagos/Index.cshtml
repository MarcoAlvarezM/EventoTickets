@page
@model EventoTickets.Web.Pages.Admin.Pagos.IndexModel
@{ ViewData["Title"] = "Pagos y validación"; }
<div class="space-y-1">
    <span class="etiqueta-seccion">Tesorería</span>
    <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Pagos y Validación</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Bandeja de comprobantes reportados por los compradores. Los pendientes aparecen primero.</p>
</div>
@if (Model.PedidoId is > 0)
{
    <div class="rounded-lg bg-surface-container-low p-3 flex flex-wrap items-center justify-between gap-2 font-body-sm text-body-sm">
        <span>Mostrando los intentos de pago del pedido seleccionado (historial de auditoría).</span>
        <a asp-page="Index" class="btn-suave h-9">Quitar filtro</a></div>
}
<div class="flex flex-wrap gap-2">
    @foreach (var (valor, texto) in new[] { ("", "Todos"), (EstadosPago.PendienteValidacion, "Pendientes"), (EstadosPago.Aprobado, "Aprobados"), (EstadosPago.Rechazado, "Rechazados") })
    {
        <a asp-page="Index" asp-route-estado="@valor" class="px-3 py-1.5 rounded-full font-label-md text-label-md @((Model.Estado ?? "") == valor ? "bg-primary text-on-primary" : "bg-surface-container-lowest shadow-sm text-on-surface-variant")">@texto</a>
    }
    <form method="get" class="ml-auto flex gap-2"><input type="hidden" asp-for="Estado" />
        <input asp-for="Busqueda" type="search" class="campo-input w-64 bg-surface-container-lowest shadow-sm" placeholder="Pago, pedido, comprador o referencia" />
        <button type="submit" class="btn-tonal h-10">Buscar</button></form>
</div>
<section class="tarjeta overflow-hidden">
    <div class="overflow-x-auto"><table class="w-full text-left">
        <thead><tr class="tabla-encabezado"><th class="tabla-celda">ID Pago</th><th class="tabla-celda">Pedido</th><th class="tabla-celda">Comprador</th><th class="tabla-celda text-right">Monto</th><th class="tabla-celda">Ref. bancaria</th><th class="tabla-celda">Fecha</th><th class="tabla-celda">Estado</th><th class="tabla-celda text-center">Acción</th></tr></thead>
        <tbody class="font-body-sm text-body-sm">
            @if (Model.Pagos.Count == 0) { <tr><td colspan="8" class="tabla-celda text-center text-on-surface-variant">No hay pagos en esta vista.</td></tr> }
            @foreach (var p in Model.Pagos)
            {
                <tr class="hover:bg-surface-container-low">
                    <td class="tabla-celda font-code-sm font-semibold text-secondary">#@p.CodigoPago</td>
                    <td class="tabla-celda font-code-sm">#@p.CodigoPedido</td>
                    <td class="tabla-celda"><div class="font-semibold">@p.CompradorNombre</div><div class="text-[11px] text-on-surface-variant">@p.CompradorCorreo</div></td>
                    <td class="tabla-celda text-right font-code-sm font-semibold">@Formato.Moneda(p.MontoReportado)
                        @if (!p.MontoCoincide) { <div class="text-amber-700 font-body-sm">Total: @Formato.Moneda(p.PedidoImporteTotal)</div> }</td>
                    <td class="tabla-celda font-code-sm text-on-surface-variant">@p.ReferenciaComprobante<div>@p.BancoOrigen</div></td>
                    <td class="tabla-celda text-on-surface-variant whitespace-nowrap">@Formato.FechaHora(p.FechaReporte)</td>
                    <td class="tabla-celda"><partial name="_EstadoBadge" model="p.Estado" /></td>
                    <td class="tabla-celda text-center"><a asp-page="Detalle" asp-route-id="@p.PagoId" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container hover:bg-secondary hover:text-on-secondary text-secondary font-label-sm text-label-sm transition-colors"><span class="material-symbols-outlined text-[16px]">receipt_long</span>Revisar</a></td>
                </tr>
            }
        </tbody></table></div>
</section>
