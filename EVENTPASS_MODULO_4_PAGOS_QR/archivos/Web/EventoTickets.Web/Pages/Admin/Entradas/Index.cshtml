@page
@model EventoTickets.Web.Pages.Admin.Entradas.IndexModel
@{ ViewData["Title"] = "Entradas emitidas"; }
<div class="space-y-1">
    <span class="etiqueta-seccion">Boletería</span>
    <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Entradas emitidas</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Boletos generados al aprobar pagos. Estados: Válida, Utilizada (ingreso registrado) y Anulada.</p>
</div>
<form method="get" class="tarjeta p-4 flex flex-col md:flex-row gap-3 md:items-end">
    <label class="flex-1 space-y-1"><span class="campo-label">Evento</span>
        <select asp-for="EventoId" class="campo-input">
            <option value="">Seleccione un evento…</option>
            @foreach (var ev in Model.Eventos) { <option value="@ev.EventoId">@ev.Nombre · @Formato.Fecha(ev.FechaEvento) (@Formato.EtiquetaEstado(ev.Estado))</option> }
        </select></label>
    <label class="md:w-48 space-y-1"><span class="campo-label">Estado</span>
        <select asp-for="Estado" class="campo-input">
            <option value="">Todos</option>
            <option value="@EstadosEntrada.Valida">Válida</option><option value="@EstadosEntrada.Utilizada">Utilizada</option><option value="@EstadosEntrada.Anulada">Anulada</option>
        </select></label>
    <button type="submit" class="btn-primario h-11"><span class="material-symbols-outlined text-[18px]">search</span>Consultar</button>
</form>
@if (Model.EventoId is > 0)
{
    <section class="tarjeta overflow-hidden">
        <div class="p-4 flex flex-wrap gap-4 font-label-md text-label-md">
            <span>Total: @Model.Entradas.Count</span>
            <span class="text-emerald-700">Válidas: @Model.Entradas.Count(e => e.Estado == EstadosEntrada.Valida)</span>
            <span class="text-secondary">Utilizadas: @Model.Entradas.Count(e => e.Estado == EstadosEntrada.Utilizada)</span>
            <span class="text-error">Anuladas: @Model.Entradas.Count(e => e.Estado == EstadosEntrada.Anulada)</span>
        </div>
        <div class="overflow-x-auto"><table class="w-full text-left">
            <thead><tr class="tabla-encabezado"><th class="tabla-celda">Código</th><th class="tabla-celda">Tipo</th><th class="tabla-celda">Titular</th><th class="tabla-celda">Pedido</th><th class="tabla-celda">Ubicación</th><th class="tabla-celda">Ingreso</th><th class="tabla-celda">Estado</th><th class="tabla-celda text-center">Boleto</th></tr></thead>
            <tbody class="font-body-sm text-body-sm">
                @if (Model.Entradas.Count == 0) { <tr><td colspan="8" class="tabla-celda text-center text-on-surface-variant">No hay entradas para este filtro.</td></tr> }
                @foreach (var e in Model.Entradas)
                {
                    <tr class="hover:bg-surface-container-low">
                        <td class="tabla-celda font-code-sm">@e.CodigoTicket</td>
                        <td class="tabla-celda">@e.TipoEntradaNombre</td>
                        <td class="tabla-celda"><div class="font-semibold">@e.NombreAsistente</div><div class="text-[11px] text-on-surface-variant">@e.DocumentoAsistente</div></td>
                        <td class="tabla-celda font-code-sm">#@e.CodigoPedido</td>
                        <td class="tabla-celda">@(e.AsientoAsignado ?? "General") · @(e.PuertaAcceso ?? "Principal")</td>
                        <td class="tabla-celda">@(e.FechaHoraIngreso is null ? "—" : $"{Formato.FechaHoraOpcional(e.FechaHoraIngreso)} · {e.ValidadorNombre}")</td>
                        <td class="tabla-celda"><partial name="_EstadoBadge" model="e.Estado" /></td>
                        <td class="tabla-celda text-center"><a asp-page="/MisEntradas/Detalle" asp-route-id="@e.EntradaId" class="btn-suave h-8" title="Ver boleto"><span class="material-symbols-outlined text-[16px]">visibility</span></a></td>
                    </tr>
                }
            </tbody></table></div>
    </section>
}
