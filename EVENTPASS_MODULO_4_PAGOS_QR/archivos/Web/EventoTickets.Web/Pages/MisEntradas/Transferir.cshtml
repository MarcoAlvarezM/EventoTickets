@page "{id:int}"
@model EventoTickets.Web.Pages.MisEntradas.TransferirModel
@{ ViewData["Title"] = "Transferir entrada"; }
<nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="/MisEntradas/Index">Mis Entradas</a> › Transferencia de titular</nav>
<section class="space-y-1">
    <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Transferencia de Entrada Digital</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Cede tu entrada a otra persona. El nuevo titular deberá presentar su documento en el acceso.</p>
</section>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <form method="post" class="lg:col-span-7 tarjeta p-6 space-y-5" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <h2 class="font-title-sm text-title-sm flex items-center gap-2"><span class="material-symbols-outlined text-secondary">person_add</span>Datos del nuevo titular</h2>
        <div class="flex flex-col gap-1.5">
            <label asp-for="Entrada.NombreAsistente" class="campo-label">Nombre completo *</label>
            <input asp-for="Entrada.NombreAsistente" class="campo-input" placeholder="Como aparece en su documento" />
            <span asp-validation-for="Entrada.NombreAsistente"></span>
        </div>
        <div class="flex flex-col gap-1.5">
            <label asp-for="Entrada.DocumentoAsistente" class="campo-label">Documento de identidad *</label>
            <input asp-for="Entrada.DocumentoAsistente" class="campo-input font-code-sm" placeholder="Cédula, DIMEX o pasaporte" />
            <span asp-validation-for="Entrada.DocumentoAsistente"></span>
        </div>
        <label class="flex items-start gap-2.5 rounded-lg bg-surface-container-low p-4 cursor-pointer">
            <input asp-for="Confirmacion" class="mt-0.5 w-4 h-4 accent-secondary" />
            <span class="font-body-sm text-body-sm">Entiendo que el código QR actual quedará invalidado y se generará uno nuevo para el titular indicado.</span>
        </label>
        <span asp-validation-for="Confirmacion"></span>
        <div class="flex justify-between gap-3">
            <a asp-page="/MisEntradas/Index" class="btn-suave">Cancelar</a>
            <button type="submit" class="btn-acento"><span class="material-symbols-outlined text-[18px]">swap_horiz</span>Confirmar transferencia</button>
        </div>
    </form>
    <aside class="lg:col-span-5 tarjeta p-6 space-y-4">
        <p class="etiqueta-seccion">Entrada a transferir</p>
        <h2 class="font-headline-md text-headline-md">@Model.Actual.EventoNombre</h2>
        <dl class="grid grid-cols-2 gap-4 font-body-sm text-body-sm">
            <div><dt class="text-on-surface-variant">Tipo</dt><dd class="font-medium">@Model.Actual.TipoEntradaNombre</dd></div>
            <div><dt class="text-on-surface-variant">Fecha</dt><dd class="font-medium">@Formato.Fecha(Model.Actual.FechaEvento)</dd></div>
            <div><dt class="text-on-surface-variant">Titular actual</dt><dd class="font-medium">@Model.Actual.NombreAsistente</dd></div>
            <div><dt class="text-on-surface-variant">Código</dt><dd class="font-code-sm break-all">@Model.Actual.CodigoTicket</dd></div>
        </dl>
        <div class="rounded-lg bg-surface-container p-4 font-body-sm text-body-sm text-on-surface-variant flex gap-2">
            <span class="material-symbols-outlined text-secondary text-[18px]">gpp_maybe</span>
            Solo se pueden transferir entradas activas de eventos que aún no ocurren.
        </div>
    </aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
