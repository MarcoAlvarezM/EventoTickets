@page
@model EventoTickets.Web.Pages.MisEntradas.IndexModel
@{ ViewData["Title"] = "Mis entradas digitales"; }
<section class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-1">
        <nav class="font-body-sm text-body-sm text-on-surface-variant"><a asp-page="/Index">Inicio</a> › Mis Entradas</nav>
        <div class="flex items-center gap-3">
            <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl tracking-tight">Mis Entradas Digitales</h1>
            <span class="badge bg-secondary/10 text-secondary">@Model.Proximas activas</span>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant">Consulta y gestiona tus credenciales oficiales de acceso a eventos.</p>
    </div>
    <div class="tarjeta px-4 py-3 flex items-center gap-3">
        <span class="material-symbols-outlined text-secondary">encrypted</span>
        <div><p class="font-label-md text-label-md">QR con firma SHA-256</p><p class="font-body-sm text-body-sm text-on-surface-variant">Se regenera al transferir la entrada.</p></div>
    </div>
</section>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex gap-2">
        <a asp-page="/MisEntradas/Index" asp-route-vista="proximos" class="px-3 py-1.5 rounded-full font-label-md text-label-md @(Model.Vista != "pasados" ? "bg-primary text-on-primary" : "bg-surface-container-lowest shadow-sm text-on-surface-variant")">Próximos eventos (@Model.Proximas)</a>
        <a asp-page="/MisEntradas/Index" asp-route-vista="pasados" class="px-3 py-1.5 rounded-full font-label-md text-label-md @(Model.Vista == "pasados" ? "bg-primary text-on-primary" : "bg-surface-container-lowest shadow-sm text-on-surface-variant")">Eventos pasados (@Model.Pasadas)</a>
    </div>
    <form method="get" class="flex items-center gap-2">
        <input type="hidden" asp-for="Vista" />
        <input asp-for="Busqueda" type="search" class="campo-input w-64 bg-surface-container-lowest shadow-sm" placeholder="Buscar por evento o código..." />
        <button type="submit" class="btn-tonal h-10"><span class="material-symbols-outlined text-[18px]">search</span></button>
    </form>
</div>

@if (Model.Entradas.Count == 0)
{
    <section class="tarjeta p-10 text-center space-y-3">
        <span class="material-symbols-outlined text-[40px] text-on-surface-variant">confirmation_number</span>
        <p class="font-title-sm text-title-sm">No tienes entradas en esta vista.</p>
        <p class="font-body-md text-body-md text-on-surface-variant">Las entradas aparecen aquí cuando un auditor aprueba tu pago.</p>
    </section>
}
<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    @foreach (var e in Model.Entradas)
    {
        var transferible = e.Estado == EstadosEntrada.Valida && e.FechaEvento.Date >= DateTime.Today && e.EventoEstado != EstadosEvento.Cancelado;
        <article class="tarjeta overflow-hidden">
            <div class="h-1.5" style="background:@(e.ColorHex ?? "#0051d5")"></div>
            <div class="p-6 flex flex-col sm:flex-row gap-6">
                <div class="flex-1 space-y-4">
                    <div class="flex items-center justify-between gap-2">
                        <span class="font-label-sm text-label-sm text-secondary uppercase">@e.TipoEntradaNombre</span>
                        <partial name="_EstadoBadge" model="e.Estado" />
                    </div>
                    <h2 class="font-headline-md text-headline-md leading-tight">@e.EventoNombre</h2>
                    <div class="grid grid-cols-2 gap-4 font-body-sm text-body-sm">
                        <div><p class="text-on-surface-variant uppercase font-label-sm text-label-sm">Fecha y hora</p><p class="font-medium">@Formato.Fecha(e.FechaEvento) · @Formato.Hora(e.HoraEvento)</p></div>
                        <div><p class="text-on-surface-variant uppercase font-label-sm text-label-sm">Recinto</p><p class="font-medium">@e.LocacionNombre</p></div>
                        <div><p class="text-on-surface-variant uppercase font-label-sm text-label-sm">Titular acreditado</p><p class="font-medium">@e.NombreAsistente</p><p class="font-code-sm text-on-surface-variant">@e.DocumentoAsistente</p></div>
                        <div><p class="text-on-surface-variant uppercase font-label-sm text-label-sm">Ubicación / acceso</p><p class="font-medium">@(e.AsientoAsignado ?? "General")</p><p class="text-on-surface-variant">@(e.PuertaAcceso ?? "Acceso principal")</p></div>
                    </div>
                    <div class="rounded-lg bg-surface-container-low p-3">
                        <p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Número de entrada · Pedido #@e.CodigoPedido</p>
                        <p class="font-code-sm text-code-sm break-all">@e.CodigoTicket</p>
                    </div>
                    @if (e.Estado == EstadosEntrada.Utilizada)
                    {
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Ingreso registrado el @Formato.FechaHoraOpcional(e.FechaHoraIngreso) por @(e.ValidadorNombre ?? "control de acceso").</p>
                    }
                </div>
                <div class="flex flex-col items-center gap-3 sm:w-44">
                    @if (e.Estado == EstadosEntrada.Valida)
                    {
                        <a asp-page="/MisEntradas/Detalle" asp-route-id="@e.EntradaId" class="p-3 bg-surface-container-lowest rounded-xl shadow-sm block" title="Ver boleto"><img src="@Url.Page("/MisEntradas/Detalle", "Qr", new { id = e.EntradaId })" alt="Código QR de la entrada @e.CodigoTicket" width="148" height="148" loading="lazy" /></a>
                        <p class="font-code-sm text-code-sm text-on-surface-variant text-center break-all">@e.HashCriptografico[..16]…</p>
                    }
                    else
                    {
                        <div class="w-40 h-40 rounded-xl bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-[48px] text-on-surface-variant">qr_code_2</span></div>
                    }
                    <a asp-page="/MisEntradas/Detalle" asp-route-id="@e.EntradaId" class="btn-suave w-full h-9"><span class="material-symbols-outlined text-[16px]">visibility</span>Ver boleto</a>
                    @if (transferible)
                    {
                        <a asp-page="/MisEntradas/Transferir" asp-route-id="@e.EntradaId" class="btn-tonal w-full h-9"><span class="material-symbols-outlined text-[16px]">swap_horiz</span>Transferir titular</a>
                    }
                </div>
            </div>
        </article>
    }
</div>
